# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

*.log

node_modules/
public
.cache
.env
postgres_data
tests
app
bootstrap
config
databse
resources
routes
storage
vendor
.dockerignore
.editorconfig
.env.example
.gitattributes
.helmignore
artisan
composer.json
composer.lock
docker-compose.yml
Dockerfile
package.json
phpunit.xml
README.md
vite.config.js
